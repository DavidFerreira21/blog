{
  "name": "Hugo Blog Design Preview",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/hugo:1": {
      "version": "0.146.0",
      "extended": true
    }
  },
  "postCreateCommand": "git submodule update --init --recursive",
  "forwardPorts": [1313],
  "portsAttributes": {
    "1313": {
      "label": "Hugo visual preview",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "nohup hugo server --bind 0.0.0.0 --port 1313 --appendPort=false --baseURL / --disableFastRender > /tmp/hugo-preview.log 2>&1 &"
}
